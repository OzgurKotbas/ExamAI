# Docker/Compose ile çalıştırmak için örnek env dosyası

APP_NAME=ExamAI
APP_ENV=development
DEBUG=true

# JWT
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (compose service adları üzerinden)
DATABASE_URL=postgresql+asyncpg://examai_user:examai_password@postgres:5432/examai_db

# Redis
REDIS_URL=redis://redis:6379/0

# Auth - Google OAuth (opsiyonel)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Gemini (opsiyonel; quiz üretimi için gerekir)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Encryption (not şifreleme için gerekli)
# 32-byte base64 anahtar üretip buraya koyun.
# Örn: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
NOTE_ENCRYPTION_KEY=

# CORS (frontend origin'inize göre güncelleyin)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

ALLOWED_HOSTS=localhost

# Upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=uploads

