# Production Environment Variables Template
# Bu dosyayı backend sunucusuna (Railway/Render) environment variables olarak ekle.
# ASLA .env dosyası olarak commit etme!

APP_NAME=ExamAI
APP_ENV=production
DEBUG=false

# Güçlü bir secret key üret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BURAYA_GUCLU_ANAHTAR_GIRINIZ

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Supabase veya Railway PostgreSQL bağlantı URL'si
# Format: postgresql+asyncpg://HOST:PORT/DBNAME
# Eğer Supabase Pooler kullanıyorsanız kullanıcı bilgilerini ayrı tutun.
DATABASE_URL=postgresql+asyncpg://aws-1-eu-central-1.pooler.supabase.com:6543/postgres
DB_USER=postgres.[PROJE_KODU]
DB_PASSWORD=your-supabase-password

# Havuz ayarları (Cloud için küçült)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Upstash veya Railway Redis URL'si
# Format: redis://default:TOKEN@HOST:PORT
REDIS_URL=redis://default:TOKEN@HOST:PORT

# Google OAuth — Production callback URL ile güncelle
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://backendwindsurf2.fly.dev/api/v1/auth/google/callback

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face (opsiyonel)
HUGGINGFACE_API_TOKENS=your-hf-token

# Not şifreleme anahtarı:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTE_ENCRYPTION_KEY=BURAYA_FERNET_KEY_GIRINIZ

# E-posta (opsiyonel - şifre sıfırlama için)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=ExamAI <your-gmail@gmail.com>

# Frontend URL'si (Railway/Vercel adresi)
FRONTEND_URL=https://exam-ai-xi.vercel.app

# CORS: Frontend domain'i (virgülle ayır)
ALLOWED_ORIGINS=https://exam-ai-xi.vercel.app

# Production'da backend domain'ini yaz
ALLOWED_HOSTS=backendwindsurf2.fly.dev

# Dosya yükleme
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=uploads
