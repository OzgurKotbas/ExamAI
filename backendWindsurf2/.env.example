# Application Settings
APP_NAME=ExamAI
APP_ENV=development
DEBUG=true

# Security
SECRET_KEY=changeme-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://examai_user:password@localhost:5432/examai_db

# Database Connection Pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Hugging Face
# Comma-separated list of tokens
HUGGINGFACE_API_TOKENS=your-hf-token-1
# Comma-separated list of model IDs OR full URLs
# Examples: Qwen/Qwen2.5-72B-Instruct or https://specific-endpoint.huggingface.co
HUGGINGFACE_MODELS=Qwen/Qwen2.5-72B-Instruct,Qwen/Qwen2.5-7B-Instruct,mistralai/Mistral-Nemo-Instruct-2407,microsoft/Phi-3.5-mini-instruct,01-ai/Yi-1.5-34B-Chat

# Qwen Modelleri
MODEL_QWEN_72B=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-72B-Instruct
MODEL_QWEN_7B=https://api-inference.huggingface.co/models/Qwen/Qwen2.5-7B-Instruct

# Mistral Modeli
MODEL_MISTRAL_NEMO=https://api-inference.huggingface.co/models/mistralai/Mistral-Nemo-Instruct-2407

# Microsoft Phi Modeli
MODEL_PHI_3_5=https://api-inference.huggingface.co/models/microsoft/Phi-3.5-mini-instruct

# Yi Modeli
MODEL_YI_34B=https://api-inference.huggingface.co/models/01-ai/Yi-1.5-34B-Chat

# Google Cloud Vision
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# Encryption
NOTE_ENCRYPTION_KEY=changeme-32-byte-base64-encoded-key

# Email (SMTP) - For password reset functionality
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=ExamAI <noreply@examai.com>
FRONTEND_URL=http://localhost:5173

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
RESET_CODE_EXPIRE_MINUTES=10

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Trusted Hosts (Production)
ALLOWED_HOSTS=localhost

# File Upload
MAX_UPLOAD_SIZE_MB=20
UPLOAD_DIR=uploads
